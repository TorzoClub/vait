{
  "name": "vait",
  "version": "5.0.0",
  "main": "./dist/vait.common.js",
  "module": "./dist/vait.esm.js",
  "typings": "./types/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test-watch": "vitest",
    "build:type": "rm -rf types/* && tsc -p ./tsconfig.type.json",
    "build:vite": "vite build",
    "build": "npm run build:type && npm run build:vite",
    "runtsc": "tsc --noEmit",
    "lint": "eslint ./src/ --ext .js,.jsx,.ts,.tsx",
    "lint-strict": "npm run lint -- --max-warnings 0"
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "repository": "git@github.com:TorzoClub/vait.git",
  "author": "vec <vec@torzo.club>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
